# Optional. Without a key Mars still works and just answers chat with simple built-in lines.
# Cloud: get a key at https://console.anthropic.com/ . Copy this file to .env (git-ignored) and fill it in.
ANTHROPIC_API_KEY=
# Local & free alternative (used when no Anthropic key is set): install Ollama, run `ollama pull llama3.2`, then set:
OLLAMA_MODEL=
# OLLAMA_HOST=http://127.0.0.1:11434
